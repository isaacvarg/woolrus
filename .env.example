# Copy to .env for local development. Values match docker/compose.dev.yml.

DATABASE_URL=postgresql://woolrus:woolrus@localhost:5442/woolrus
TEST_DATABASE_URL=postgresql://woolrus:woolrus@localhost:5442/woolrus_test

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-change-me-dev-only-change-me
# Comma-separated emails that may always sign in and are made Admin on first sign-in (bootstrap).
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 32-byte key (base64) for encrypting secrets stored in the settings table.
# Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# Object storage (RustFS locally)
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=woolrus
S3_SECRET_KEY=woolrus-secret
S3_BUCKET=woolrus-attachments

# WooCommerce (local dev store from docker/compose.dev.yml). In production these live in Settings.
WOO_URL=http://localhost:8090
WOO_CONSUMER_KEY=ck_woolrus_dev_key
WOO_CONSUMER_SECRET=cs_woolrus_dev_secret

# Shipping providers. `fake` swaps ShipStation and Bridge Source for in-memory fakes (development
# and test only; ignored in production). Unset to use the real adapters with Settings → Shipping.
SHIPPING_PROVIDERS=fake

# Error tracking (GlitchTip / Sentry DSN). Empty disables it.
SENTRY_DSN=
# Shown on every error in GlitchTip; defaults to NODE_ENV. WOOLRUS_VERSION is the release (set by compose in prod).
SENTRY_ENVIRONMENT=
WOOLRUS_VERSION=

LOG_LEVEL=debug

# Production configuration. Copy to docker/.env.prod on the host; never commit the real file.

WOOLRUS_VERSION=latest
WEB_PORT=3000

POSTGRES_USER=woolrus
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://woolrus:CHANGE_ME@postgres:5432/woolrus

BETTER_AUTH_URL=https://woolrus.example.internal
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

SETTINGS_ENCRYPTION_KEY=

S3_ENDPOINT=http://storage:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=woolrus-attachments

GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=http://woolrus-host:8000
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

LOG_LEVEL=info

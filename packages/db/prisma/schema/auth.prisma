// People, sign-in and floor stations.
// User/Session/Account/Verification follow Better Auth's expected shape; the rest is ours.

enum Role {
  ADMIN
  PICKER
  PACKER
  QA
  SHIPPER

  @@map("role")
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
  HIGH_CONTRAST

  @@map("theme")
}

enum Locale {
  en
  es

  @@map("locale")
}

model User {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  roles            Role[]   @default([])
  active           Boolean  @default(true)
  locale           Locale   @default(en)
  theme            Theme    @default(SYSTEM)
  sidebarCollapsed Boolean  @default(false) @map("sidebar_collapsed")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Station sign-in. PIN is hashed; badge is the value printed in the user's badge barcode.
  pinHash           String?   @map("pin_hash")
  pinFailedAttempts Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil    DateTime? @map("pin_locked_until") @db.Timestamptz(3)
  badgeCode         String?   @unique @map("badge_code")
  badgeIssuedAt     DateTime? @map("badge_issued_at") @db.Timestamptz(3)

  sessions           Session[]
  accounts           Account[]
  invitationsSent    Invitation[]        @relation("InvitedBy")
  stationsRegistered Station[]           @relation("StationRegisteredBy")
  stationActivations StationActivation[]

  claimedOrders      Order[]             @relation("OrderClaimedBy")
  stageEvents        OrderStageEvent[]
  pickedItems        OrderItem[]         @relation("ItemPickedBy")
  packedItems        PackageItem[]       @relation("PackedBy")
  verifiedItems      PackageItem[]       @relation("QaVerifiedBy")
  labelsPurchased    ShippingLabel[]     @relation("LabelPurchasedBy")
  labelsVoided       ShippingLabel[]     @relation("LabelVoidedBy")
  manifestsCreated   Manifest[]
  notes              Note[]
  issuesReported     QualityIssue[]      @relation("IssueReporter")
  issuesResponsible  QualityIssue[]      @relation("IssueResponsible")
  issuesResolved     QualityIssue[]      @relation("IssueResolver")
  voidsCreated       ItemVoid[]          @relation("VoidedBy")
  voidsUndone        ItemVoid[]          @relation("VoidUndoneBy")
  voidsResolved      ItemVoid[]          @relation("VoidResolvedBy")
  returnsCreated     ReturnRequest[]
  auditEvents        AuditEvent[]
  idempotentRequests IdempotentRequest[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Sign-in is invite-only: an account can only be created for an email with an open invitation.
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  email       String    @unique
  roles       Role[]
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedBy User? @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@map("invitations")
}

/// A shared floor device (tablet, packing station). It holds a long-lived device credential;
/// staff switch onto it with a PIN or badge scan.
model Station {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String    @unique
  tokenHash      String    @unique @map("token_hash")
  active         Boolean   @default(true)
  registeredById String?   @map("registered_by_id") @db.Uuid
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  registeredBy User?               @relation("StationRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  activations  StationActivation[]
  stageEvents  OrderStageEvent[]
  auditEvents  AuditEvent[]

  @@map("stations")
}

enum StationUnlockMethod {
  PIN
  BADGE

  @@map("station_unlock_method")
}

enum StationLockReason {
  SWITCHED_USER
  IDLE
  MANUAL
  STATION_REVOKED

  @@map("station_lock_reason")
}

/// One stretch of a user being the active user on a station.
model StationActivation {
  id        String              @id @default(uuid(7)) @db.Uuid
  stationId String              @map("station_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  method    StationUnlockMethod
  startedAt DateTime            @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime?           @map("ended_at") @db.Timestamptz(3)
  endReason StationLockReason?  @map("end_reason")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stationId, endedAt])
  @@map("station_activations")
}

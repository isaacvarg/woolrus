# Production configuration. On the host, save it as .env next to compose.prod.yml (in Arcane: the project's
# .env). It must be named .env: compose reads it for ${...} substitution and passes it to the apps.
# Never commit the real file.

# Pin a release (e.g. 2.0.0, the v2.0.0 tag without the v). `latest` is the newest v* tag; `main` tracks main.
WOOLRUS_VERSION=latest
WEB_PORT=3000

# Nightly backups (cron syntax, UTC). Dumps go to the `backups` volume; set an absolute host path to write
# them to a folder instead (e.g. /srv/woolrus/backups), which makes copying them off the host easier.
BACKUP_SCHEDULE=0 2 * * *
BACKUP_PATH=backups

POSTGRES_USER=woolrus
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://woolrus:CHANGE_ME@postgres:5432/woolrus

BETTER_AUTH_URL=https://woolrus.example.internal
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

SETTINGS_ENCRYPTION_KEY=

S3_ENDPOINT=http://storage:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=woolrus-attachments

GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=http://woolrus-host:8000
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

LOG_LEVEL=info

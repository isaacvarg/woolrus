{
  "name": "@woolrus/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development SERVICE_NAME=worker tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "sync:pull": "NODE_ENV=development tsx --env-file-if-exists=../../.env src/cli.ts pull",
    "sync:products": "NODE_ENV=development tsx --env-file-if-exists=../../.env src/cli.ts products",
    "pii:purge": "NODE_ENV=development tsx --env-file-if-exists=../../.env src/cli.ts purge-pii",
    "jobs:install": "tsx --env-file-if-exists=../../.env src/cli.ts install-jobs"
  },
  "dependencies": {
    "@woolrus/core": "workspace:*",
    "@woolrus/db": "workspace:*",
    "@woolrus/logger": "workspace:*",
    "pg-boss": "12.38.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@woolrus/config": "workspace:*",
    "tsdown": "0.23.1",
    "tsx": "^4.23.15",
    "vitest": "5.0.4"
  }
}

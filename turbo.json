{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["BETTER_AUTH_URL", "NEXT_PUBLIC_*"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^generate", "generate"],
      "passThroughEnv": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "STORAGE_LIVE",
        "SHIPPING_PROVIDERS",
        "SHIPSTATION_LIVE_API_KEY"
      ]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "SHIPPING_PROVIDERS",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "WOOLRUS_VERSION"
      ]
    }
  }
}

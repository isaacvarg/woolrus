# Real-store test (scripts/realtest/README.md). Copy to .env.realtest (git-ignored) and fill in.
# Use READ-ONLY WooCommerce REST API keys: Woolrus only reads, and read-only keys guarantee it.

# The store's address, e.g. https://shop.example.com (or a staging copy).
REALTEST_WOO_URL=
REALTEST_WOO_CONSUMER_KEY=
REALTEST_WOO_CONSUMER_SECRET=

# Throwaway database on the v2 dev Postgres (:5442). Must be named woolrus_realtest:
# `realtest.sh down` drops it, and the script refuses any other name.
REALTEST_DATABASE_URL=postgresql://woolrus:woolrus@localhost:5442/woolrus_realtest
